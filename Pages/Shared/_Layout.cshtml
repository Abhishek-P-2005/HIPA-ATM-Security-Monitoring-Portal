<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - HIPA</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    @{
        var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    }

    <header class="hitachi-header">

        <div class="hitachi-title-bar">
            <a class="hitachi-brand"
               asp-area=""
               asp-page="/Dashboard">
                HIPA
            </a>

            <div class="hitachi-user-area">
                <partial name="_LoginPartial" />
            </div>
        </div>

        <nav class="hitachi-menu-bar">

            <ul class="hitachi-menu">

                <li>
                    <a class="@(currentPage == "/Dashboard" ? "active-page" : "")"
                       asp-area=""
                       asp-page="/Dashboard">
                        Dashboard
                    </a>
                </li>

                <li class="dropdown">
                    <a class="dropdown-toggle"
                       href="#"
                       role="button"
                       data-bs-toggle="dropdown">
                        User Management
                    </a>

                    <ul class="dropdown-menu">
                        <li>
                            <a class="dropdown-item" asp-page="/UserManagement/Users">
                                Users
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-page="/UserManagement/Roles">
                                Roles
                            </a>
                        </li>
                    </ul>
                </li>

                <li class="dropdown">
                    <a class="dropdown-toggle"
                       href="#"
                       role="button"
                       data-bs-toggle="dropdown">
                        Policy Management
                    </a>

                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#">Policy List</a></li>
                        <li><a class="dropdown-item" href="#">Policy Sync</a></li>
                    </ul>
                </li>

                <li class="dropdown">
                    <a class="dropdown-toggle @(currentPage != null && currentPage.StartsWith("/SSTManagement") ? "active-page" : "")"
                       href="#"
                       role="button"
                       data-bs-toggle="dropdown">
                        SST Management
                    </a>

                    <ul class="dropdown-menu">
                        <li>
                            <a class="dropdown-item" href="/SSTManagement/SSTCrud">
                                SST Crud
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="#">
                                SST Bulk Upload
                            </a>
                        </li>
                    </ul>
                </li>

                <li>
                    <a class="@(currentPage == "/Reports" ? "active-page" : "")"
                       asp-area=""
                       asp-page="/Reports">
                        Reports
                    </a>
                </li>

                <li>
                    <a class="@(currentPage == "/ATMStatus" ? "active-page" : "")"
                       asp-area=""
                       asp-page="/ATMStatus">
                        SST Status
                    </a>
                </li>

            </ul>

            @if (currentPage == "/Dashboard")
            {
                <button class="dashboard-fixed-download" title="Download">
                    ⬇
                </button>
            }

        </nav>

    </header>

    <div class="container-fluid app-body">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container-fluid">
            &copy; 2026 - HIPA
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
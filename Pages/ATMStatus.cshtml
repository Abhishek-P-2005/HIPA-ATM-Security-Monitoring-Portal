<script>
    document.getElementById("sstSearchBtn").addEventListener("click", searchATMStatus);

    async function searchATMStatus() {
        const atmId = document.getElementById("sstSearchInput").value.trim();

        if (!atmId) {
            alert("Please enter Terminal ID");
            return;
        }

        const response = await fetch(`/ATMStatus?handler=ATMStatus&atmId=${encodeURIComponent(atmId)}`);
        const result = await response.json();

        if (!result.success) {
            alert(result.message);
            return;
        }

        const data = result.data;

        setInputValue("sstTerminalId", data.atmid);
        setInputValue("sstLocation", data.location);
        setInputValue("sstTerminalIp", data.terminalIP);
        setInputValue("sstState", data.state);
        setInputValue("sstNatIp", data.natIP);
        setInputValue("sstRegion", data.region);

        const formattedDate = formatDateTime(data.lastUpdated);
        setInputValue("sstLastModified", formattedDate);

        setText("sstLastUpdated", formattedDate);
        setText("hdeLastUpdated", formattedDate);

        setText("terminalStatus", data.terminalStatus);
        setText("protectionStatus", data.protectionStatus);

        setText("processor", data.processor);
        setText("motherBoard", data.motherBoard);
        setText("ram", data.ram);
        setText("osName", data.osName);
        setText("osVersion", data.osVersion);
        setText("clientVersion", data.clientVersion);
        setText("policyVersion", data.policyVersion);

        setText("hipaProtection", data.hipaProtection);
        setText("cdProtection", data.cddvdProtection);
        setText("usbProtection", data.usbProtection);
        setText("powerShellProtection", data.powerShellProtection);
        setText("autoRunProtection", data.autoRunProtection);
        setText("cmdProtection", data.commandPromptProtection);
        setText("controlPanelProtection", data.controlPanelProtection);
        setText("registryProtection", data.registryProtection);
        setText("groupPolicyProtection", data.groupPolicyProtection);
        setText("servicesProtection", data.servicesProtection);

        setText("computerName", data.computerName);
        setText("biosVersion", data.biosVersion);
        setText("macAddress", data.macAddress);
        setText("noOfHdd", data.noOfHDD);
        setText("hddSerial", data.hddSerialNumber);
        setText("lastHotFix", data.lastHotFix);

        loadDriveRows(data);
    }

    function setText(id, value) {
        const element = document.getElementById(id);
        if (element) {
            element.innerText = value ?? "-";
        }
    }

    function setInputValue(id, value) {
        const element = document.getElementById(id);
        if (element) {
            element.value = value ?? "-";
        }
    }

    function formatDateTime(value) {

        if (!value)
            return "-";

        const date = new Date(value);

        return date.toLocaleString("en-IN", {
            day: "2-digit",
            month: "2-digit",
            year: "numeric",
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit"
        });
    }

    function loadDriveRows(data) {
        const tbody = document.getElementById("driveRows");

        if (!tbody) return;

        tbody.innerHTML = `
            <tr>
                <td>C:</td>
                <td>${data.driveC_TotalSize ?? "-"}</td>
                <td>${data.driveC_UsedSize ?? "-"}</td>
                <td>${data.driveC_FreeSize ?? "-"}</td>
                <td>${data.driveC_EncryptionStatus ?? "-"}</td>
            </tr>
            <tr>
                <td>D:</td>
                <td>${data.driveD_TotalSize ?? "-"}</td>
                <td>${data.driveD_UsedSize ?? "-"}</td>
                <td>${data.driveD_FreeSize ?? "-"}</td>
                <td>${data.driveD_EncryptionStatus ?? "-"}</td>
            </tr>
            <tr>
                <td>E:</td>
                <td>${data.driveE_TotalSize ?? "-"}</td>
                <td>${data.driveE_UsedSize ?? "-"}</td>
                <td>${data.driveE_FreeSize ?? "-"}</td>
                <td>${data.driveE_EncryptionStatus ?? "-"}</td>
            </tr>
        `;
    }
</script>
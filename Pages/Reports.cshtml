@page
@model ATMMonitoringWebApp.Pages.ReportsModel
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@{
    ViewData["Title"] = "Reports";
}

    <div class="dashboard-container reports-page">

    <div class="reports-action-row">
        <button type="button" class="reports-generate-btn">
            Generate Report
        </button>
    </div>

    <div class="summary-grid">
        <div class="summary-card">
            <h3>Total Reports</h3>
            <h2>12</h2>
            <p>Available report types</p>
        </div>

        <div class="summary-card green-card">
            <h3>Generated Today</h3>
            <h2>5</h2>
            <p>Reports prepared today</p>
        </div>

        <div class="summary-card blue-card">
            <h3>Scheduled</h3>
            <h2>3</h2>
            <p>Auto reports configured</p>
        </div>

        <div class="summary-card red-card">
            <h3>Failed</h3>
            <h2>1</h2>
            <p>Needs retry</p>
        </div>
    </div>

    <div class="dashboard-grid">

        <div class="dashboard-panel">
            <h3>Report Categories</h3>

            <div class="report-card">
                <div>
                    <h4>Device Connectivity Report</h4>
                    <p>Connected and disconnected ATM terminal summary</p>
                </div>
                <button class="small-action-btn">View</button>
            </div>

            <div class="report-card">
                <div>
                    <h4>Encryption Status Report</h4>
                    <p>Fully encrypted, partially encrypted, and non-encrypted device list</p>
                </div>
                <button class="small-action-btn">View</button>
            </div>

            <div class="report-card">
                <div>
                    <h4>HIPA Protection Report</h4>
                    <p>Module-wise protection and policy sync status</p>
                </div>
                <button class="small-action-btn">View</button>
            </div>

            <div class="report-card">
                <div>
                    <h4>Hardware Inventory Report</h4>
                    <p>OS, RAM, HDD, BIOS, motherboard, and volume details</p>
                </div>
                <button class="small-action-btn">View</button>
            </div>
        </div>

        <div class="dashboard-panel">
            <h3>Quick Export</h3>

            <div class="export-box">
                <label>Report Type</label>
                <select>
                    <option>Device Connectivity</option>
                    <option>Encryption Status</option>
                    <option>HIPA Protection</option>
                    <option>Hardware Inventory</option>
                </select>
            </div>

            <div class="export-box">
                <label>Region</label>
                <select>
                    <option>All Regions</option>
                    <option>North</option>
                    <option>South</option>
                    <option>East</option>
                    <option>West</option>
                </select>
            </div>

            <div class="export-box">
                <label>Format</label>
                <select>
                    <option>CSV</option>
                    <option>PDF</option>
                    <option>Excel</option>
                </select>
            </div>

            <button class="btn-primary export-full-btn">Download Report</button>
        </div>

    </div>

    <div class="dashboard-panel">
        <h3>Recent Generated Reports</h3>

        <table class="dashboard-table">
            <thead>
                <tr>
                    <th>Report ID</th>
                    <th>Report Name</th>
                    <th>Generated By</th>
                    <th>Generated Time</th>
                    <th>Format</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                <tr>
                    <td>RPT-1001</td>
                    <td>Device Connectivity Report</td>
                    <td>admin@atm.com</td>
                    <td>21-05-2026 13:20</td>
                    <td>CSV</td>
                    <td><span class="badge badge-online">Completed</span></td>
                    <td><a class="table-link" href="#">Download</a></td>
                </tr>

                <tr>
                    <td>RPT-1002</td>
                    <td>Encryption Status Report</td>
                    <td>admin@atm.com</td>
                    <td>21-05-2026 12:45</td>
                    <td>Excel</td>
                    <td><span class="badge badge-online">Completed</span></td>
                    <td><a class="table-link" href="#">Download</a></td>
                </tr>

                <tr>
                    <td>RPT-1003</td>
                    <td>HIPA Protection Report</td>
                    <td>admin@atm.com</td>
                    <td>21-05-2026 11:50</td>
                    <td>PDF</td>
                    <td><span class="badge badge-warning">Processing</span></td>
                    <td><a class="table-link" href="#">View</a></td>
                </tr>

                <tr>
                    <td>RPT-1004</td>
                    <td>Hardware Inventory Report</td>
                    <td>admin@atm.com</td>
                    <td>21-05-2026 10:30</td>
                    <td>CSV</td>
                    <td><span class="badge badge-offline">Failed</span></td>
                    <td><a class="table-link" href="#">Retry</a></td>
                </tr>
            </tbody>
        </table>
    </div>

</div>
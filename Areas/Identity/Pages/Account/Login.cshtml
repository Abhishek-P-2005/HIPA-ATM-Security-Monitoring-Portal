@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <title>ATM Monitoring Login</title>

    ```
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    ```

</head>

<body>

    <div class="login-page-wrapper">
        <div class="login-card">

            
            <div class="login-brand">
                HIPA
            </div>

            <h1>Log in</h1>

            <p class="login-subtitle">
                Enter your email and password to request OTP.
            </p>

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger login-validation">
                </div>

                <div class="login-form-group">
                    <label asp-for="Input.Email">Email</label>

                    <input asp-for="Input.Email"
                           class="login-input"
                           placeholder="Enter email address" />

                    <span asp-validation-for="Input.Email"
                          class="text-danger">
                    </span>
                </div>

                <div class="login-form-group">
                    <label asp-for="Input.Password">Password</label>

                    <input asp-for="Input.Password"
                           class="login-input"
                           placeholder="Enter password" />

                    <span asp-validation-for="Input.Password"
                          class="text-danger">
                    </span>
                </div>

                <button type="submit"
                        class="login-btn">
                    Request OTP
                </button>

                <div class="login-links">
                    <a asp-page="./ForgotPassword">
                        Forgot your password?
                    </a>
                </div>

            </form>

        </div>
        ```

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>

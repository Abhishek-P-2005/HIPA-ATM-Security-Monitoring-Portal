@page
@model VerifyOtpModel

@{
    ViewData["Title"] = "Verify OTP";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Verify OTP - ATMMonitoringWebApp</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <div class="login-page-wrapper">
        <div class="login-card">

            <div class="login-brand">
                HIPA<br />
                
            </div>

            <h1>Verify OTP</h1>

            <p class="login-subtitle">
                OTP has been sent to <strong>@Model.Email</strong>.
            </p>

            <form method="post">

                <input type="hidden" asp-for="Email" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger login-validation">
                </div>

                <div class="login-form-group">
                    <label asp-for="Otp">Enter OTP</label>

                    <input asp-for="Otp"
                           class="login-input"
                           maxlength="6"
                           placeholder="Enter 6-digit OTP" />

                    <span asp-validation-for="Otp"
                          class="text-danger">
                    </span>
                </div>

                <button type="submit"
                        class="login-btn">
                    Log in
                </button>

                <div class="login-links">
                    <a asp-page="./Login">Back to Login</a>
                </div>

            </form>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>
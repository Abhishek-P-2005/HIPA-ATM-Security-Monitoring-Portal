@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<div class="login-page-wrapper">

    <div class="login-card">

        <div class="login-brand">
            ATMMonitoringWebApp
        </div>

        <h1>Register</h1>

        <p class="login-subtitle">
            Create a new user account for the ATM Monitoring Dashboard.
        </p>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger login-validation"
                 role="alert">
            </div>

            <div class="login-form-group">
                <label asp-for="Input.Email">Email</label>

                <input asp-for="Input.Email"
                       class="login-input"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="Enter email address" />

                <span asp-validation-for="Input.Email"
                      class="text-danger">
                </span>
            </div>

            <div class="login-form-group">
                <label asp-for="Input.Password">Password</label>

                <input asp-for="Input.Password"
                       class="login-input"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Enter password" />

                <span asp-validation-for="Input.Password"
                      class="text-danger">
                </span>
            </div>

            <div class="login-form-group">
                <label asp-for="Input.ConfirmPassword">Confirm Password</label>

                <input asp-for="Input.ConfirmPassword"
                       class="login-input"
                       autocomplete="new-password"
                       aria-required="true"
                       placeholder="Confirm password" />

                <span asp-validation-for="Input.ConfirmPassword"
                      class="text-danger">
                </span>
            </div>

            <button id="registerSubmit"
                    type="submit"
                    class="login-btn">
                Register
            </button>

            <div class="login-links">
                <a asp-page="./Login">
                    Already have an account? Log in
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}